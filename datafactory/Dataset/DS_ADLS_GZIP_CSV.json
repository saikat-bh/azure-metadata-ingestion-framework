{
    "name": "DS_ADLS_GZIP_CSV",
    "type": "Microsoft.DataFactory/factories/datasets",
    "properties": {
        "type": "DelimitedText",
        "description": "Parameterized gzip-compressed CSV dataset on ADLS Gen2. ADF automatically decompresses the .gz archive before parsing the inner delimited content. All connection and path details resolved at runtime from EDP_Metadata.",
        "parameters": {
            "URL": { "type": "String" },
            "container": { "type": "String" },
            "directory": { "type": "String" },
            "filename": { "type": "String" },
            "columnDelimiter": { "type": "String" }
        },
        "linkedServiceName": {
            "referenceName": "LS_ADLS_SAMI",
            "type": "LinkedServiceReference",
            "parameters": { "URL": "@dataset().URL" }
        },
        "typeProperties": {
            "location": {
                "type": "AzureBlobFSLocation",
                "fileSystem": "@dataset().container",
                "folderPath": "@dataset().directory",
                "fileName": "@dataset().filename"
            },
            "columnDelimiter": "@dataset().columnDelimiter",
            "compressionCodec": "gzip",
            "escapeChar": "\\",
            "quoteChar": "\"",
            "firstRowAsHeader": true,
            "encodingName": "UTF-8"
        },
        "annotations": []
    }
}
