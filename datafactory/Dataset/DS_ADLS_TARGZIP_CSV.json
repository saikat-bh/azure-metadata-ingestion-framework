{
    "name": "DS_ADLS_TARGZIP_CSV",
    "type": "Microsoft.DataFactory/factories/datasets",
    "properties": {
        "type": "DelimitedText",
        "description": "Parameterized tar.gz-compressed CSV dataset on ADLS Gen2. ADF automatically decompresses the .tar.gz archive (TarGzip codec) and reads the inner delimited content. All files within the tar archive are read as one logical source.",
        "parameters": {
            "URL": { "type": "String" },
            "container": { "type": "String" },
            "directory": { "type": "String" },
            "filename": { "type": "String" },
            "columnDelimiter": { "type": "String" }
        },
        "linkedServiceName": {
            "referenceName": "LS_ADLS_SAMI",
            "type": "LinkedServiceReference",
            "parameters": { "URL": "@dataset().URL" }
        },
        "typeProperties": {
            "location": {
                "type": "AzureBlobFSLocation",
                "fileSystem": "@dataset().container",
                "folderPath": "@dataset().directory",
                "fileName": "@dataset().filename"
            },
            "columnDelimiter": "@dataset().columnDelimiter",
            "compressionCodec": "TarGzip",
            "escapeChar": "\\",
            "quoteChar": "\"",
            "firstRowAsHeader": true,
            "encodingName": "UTF-8"
        },
        "annotations": []
    }
}
