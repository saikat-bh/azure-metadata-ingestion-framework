{
    "name": "DS_ADLS_CSV",
    "type": "Microsoft.DataFactory/factories/datasets",
    "properties": {
        "type": "DelimitedText",
        "description": "Parameterized CSV dataset on ADLS Gen2. All properties (storage URL, container, directory, filename, and column delimiter) are resolved at runtime from EDP_Metadata via the pipeline Lookup activity.",
        "parameters": {
            "URL": {
                "type": "String"
            },
            "container": {
                "type": "String"
            },
            "directory": {
                "type": "String"
            },
            "filename": {
                "type": "String"
            },
            "columnDelimiter": {
                "type": "String"
            }
        },
        "linkedServiceName": {
            "referenceName": "LS_ADLS_SAMI",
            "type": "LinkedServiceReference",
            "parameters": {
                "URL": "@dataset().URL"
            }
        },
        "typeProperties": {
            "location": {
                "type": "AzureBlobFSLocation",
                "fileSystem": "@dataset().container",
                "folderPath": "@dataset().directory",
                "fileName": "@dataset().filename"
            },
            "columnDelimiter": "@dataset().columnDelimiter",
            "escapeChar": "\\",
            "quoteChar": "\"",
            "firstRowAsHeader": true,
            "encodingName": "UTF-8"
        },
        "annotations": []
    }
}
